#!/bin/bash
#
# Manage the phase 1 access keys that gate the repository in nginx.
#
# Several keys can be valid at once, which is what makes rotation possible:
# add a new key, ship it to clients, then revoke the old one.

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

usage() {
    cat >&2 <<EOF
usage: appstore-key <command>

Commands:
  list                 show the access keys nginx will accept
  add [--label NAME]   generate and record a new key
  revoke <key|label>   remove a key
  sync                 rewrite the nginx map file from the key list

After add, revoke or sync, reload nginx:
  nginx -t && systemctl reload nginx
EOF
    exit "${1:-1}"
}

case "${1:-}" in -h|--help) usage 0 ;; esac

load_config

# Reads the key file into two parallel arrays.
keys=()
labels=()
created=()
read_keys() {
    keys=(); labels=(); created=()
    [ -f "$ACCESS_KEYS_FILE" ] || return 0
    local key label when
    while IFS=$'\t' read -r key label when || [ -n "$key" ]; do
        case "$key" in ''|'#'*) continue ;; esac
        # The map file is nginx configuration. Anything that is not a plain hex
        # key could inject directives into it, so refuse rather than emit it.
        if ! [[ "$key" =~ ^[0-9a-f]{32,128}$ ]]; then
            die "$ACCESS_KEYS_FILE contains a malformed key. Keys must be hex; use 'appstore-key add'."
        fi
        keys+=("$key")
        labels+=("${label:-unnamed}")
        created+=("${when:-unknown}")
    done < "$ACCESS_KEYS_FILE"
}

write_nginx_map() {
    local out="$APPSTORE_NGINX_KEYS_FILE" tmp var i
    var="$(nginx_header_var)"
    tmp="$(tmpfile map)"

    {
        printf '# Generated by appstore-key. Do not edit; changes are overwritten.\n'
        printf '# Regenerate with: appstore-key sync\n'
        printf '#\n'
        printf '# Access keys are 64 characters, which does not fit in nginx'"'"'s default\n'
        printf '# map_hash_bucket_size of 64. Without this, nginx refuses to start with\n'
        printf '# "could not build map_hash". If some other config in the same http block\n'
        printf '# already sets this directive, delete whichever copy is redundant.\n'
        printf 'map_hash_bucket_size 128;\n'
        # shellcheck disable=SC2016  # $... here is nginx syntax, not shell
        printf 'map $%s $appstore_access_ok {\n' "$var"
        if [ "$APPSTORE_ACCESS_KEY_REQUIRED" != 1 ]; then
            printf '    # APPSTORE_ACCESS_KEY_REQUIRED=0: the gate is open.\n'
            printf '    default 1;\n'
        else
            printf '    default 0;\n'
            for i in "${!keys[@]}"; do
                printf '    "%s" 1;  # %s\n' "${keys[$i]}" "${labels[$i]}"
            done
        fi
        printf '}\n'
    } > "$tmp"

    mkdir -p "$(dirname "$out")"
    chmod 640 "$tmp"
    mv -f "$tmp" "$out"
    info "wrote $out"

    if [ "$APPSTORE_ACCESS_KEY_REQUIRED" = 1 ] && [ "${#keys[@]}" -eq 0 ]; then
        warn "no access keys are configured and the gate is required:"
        warn "nginx will reject every request until you run 'appstore-key add'."
    fi
    detail "reload nginx to apply: nginx -t && systemctl reload nginx"
}

cmd="${1:-list}"
[ $# -gt 0 ] && shift

case "$cmd" in
    list)
        read_keys
        if [ "$APPSTORE_ACCESS_KEY_REQUIRED" != 1 ]; then
            info "access gate: DISABLED (APPSTORE_ACCESS_KEY_REQUIRED=0)"
        else
            info "access gate: required, header $APPSTORE_AUTH_HEADER"
        fi
        if [ "${#keys[@]}" -eq 0 ]; then
            info "no keys configured"
        else
            printf '\n%-64s  %-16s  %s\n' "KEY" "LABEL" "CREATED" >&2
            for i in "${!keys[@]}"; do
                printf '%-64s  %-16s  %s\n' "${keys[$i]}" "${labels[$i]}" "${created[$i]}" >&2
            done
        fi
        ;;

    add)
        label="unnamed"
        while [ $# -gt 0 ]; do
            case "$1" in
                --label) label="${2:-}"; shift 2 ;;
                *) die "unknown argument: $1" ;;
            esac
        done
        [[ "$label" =~ ^[A-Za-z0-9._-]+$ ]] || die "--label may only contain letters, digits, dot, dash and underscore"
        need_cmd openssl
        read_keys
        for existing in "${labels[@]}"; do
            [ "$existing" = "$label" ] && die "a key labelled '$label' already exists"
        done
        new_key="$(openssl rand -hex 32)"
        umask 077
        printf '%s\t%s\t%s\n' "$new_key" "$label" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$ACCESS_KEYS_FILE"
        chmod 600 "$ACCESS_KEYS_FILE"
        read_keys
        write_nginx_map
        info ""
        info "new access key ($label):"
        printf '%s\n' "$new_key"
        ;;

    revoke)
        target="${1:-}"
        [ -n "$target" ] || usage
        read_keys
        tmp="$(tmpfile keys)"
        removed=0
        for i in "${!keys[@]}"; do
            if [ "${keys[$i]}" = "$target" ] || [ "${labels[$i]}" = "$target" ]; then
                removed=$((removed + 1))
                continue
            fi
            printf '%s\t%s\t%s\n' "${keys[$i]}" "${labels[$i]}" "${created[$i]}" >> "$tmp"
        done
        [ "$removed" -gt 0 ] || die "no key matching '$target'"
        umask 077
        touch "$tmp"
        chmod 600 "$tmp"
        mv -f "$tmp" "$ACCESS_KEYS_FILE"
        info "revoked $removed key(s)"
        read_keys
        write_nginx_map
        warn "Devices still carrying that key stop receiving updates once nginx reloads."
        ;;

    sync)
        read_keys
        write_nginx_map
        ;;

    -h|--help) usage 0 ;;
    *) die "unknown command: $cmd (try --help)" ;;
esac
