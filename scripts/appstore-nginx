#!/bin/bash
#
# Render the nginx site configuration for this repository.

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

usage() {
    cat >&2 <<EOF
usage: appstore-nginx [options]

  (no options)        print the site configuration on stdout
  --install PATH      write it to PATH instead
  --cert-dir DIR      TLS certificate directory
                      (default: /etc/letsencrypt/live/<server name>)
  --print-pins        print certificate pins for the client's
                      network_security_config.xml, read from the live server
EOF
    exit "${1:-1}"
}

install_path=""
cert_dir=""
print_pins=0
while [ $# -gt 0 ]; do
    case "$1" in
        --install) need_value "$1" $# "${2:-}"; install_path="$2"; shift 2 ;;
        --cert-dir) need_value "$1" $# "${2:-}"; cert_dir="$2"; shift 2 ;;
        --print-pins) print_pins=1; shift ;;
        -h|--help) usage 0 ;;
        *) die "unknown argument: $1 (try --help)" ;;
    esac
done

load_config
server_name="${APPSTORE_SERVER_NAME:-${APPSTORE_BASE_URL#https://}}"
server_name="${server_name%%/*}"
[ -n "$cert_dir" ] || cert_dir="/etc/letsencrypt/live/$server_name"

# --- certificate pins -------------------------------------------------------

if [ "$print_pins" = 1 ]; then
    need_cmd openssl
    chain="$(tmpfile chain.pem)"
    openssl s_client -servername "$server_name" -connect "$server_name:443" \
        -showcerts </dev/null 2>/dev/null > "$chain" ||
        die "could not connect to $server_name:443"

    split_dir="$TMP_DIR/chain"
    mkdir -p "$split_dir"
    awk -v dir="$split_dir" '
        /-----BEGIN CERTIFICATE-----/ { n++; out = sprintf("%s/cert%02d.pem", dir, n) }
        n { print > out }
        /-----END CERTIFICATE-----/ { close(out) }
    ' "$chain"

    found=0
    for cert in "$split_dir"/cert*.pem; do
        [ -f "$cert" ] || continue
        found=1
        subject="$(openssl x509 -in "$cert" -noout -subject 2>/dev/null || echo "?")"
        pin="$(openssl x509 -in "$cert" -pubkey -noout 2>/dev/null |
               openssl pkey -pubin -outform der 2>/dev/null |
               openssl dgst -sha256 -binary | base64)"
        printf '<!-- %s -->\n<pin digest="SHA-256">%s</pin>\n' "$subject" "$pin"
    done
    [ "$found" = 1 ] || die "no certificates were returned by $server_name"

    info ""
    warn "Pin an intermediate or root you control the rotation of, and always"
    warn "include a backup pin. A pinned certificate that rotates without a new"
    warn "client build stops every device from receiving updates."
    exit 0
fi

# --- site configuration -----------------------------------------------------

metadata_file="$(metadata_filename)"

# `http2 on;` is nginx 1.25.1 and later. Older builds, including the nginx in
# Ubuntu 24.04, take http2 as a listen parameter instead, and reject the
# directive outright. Emit whichever form the installed nginx understands, and
# assume a current nginx when there is none to ask.
listen_https="listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;"
if command -v nginx >/dev/null 2>&1; then
    nginx_version="$(nginx -v 2>&1 | sed -n 's#.*nginx/\([0-9.]*\).*#\1#p')"
    if [ -n "$nginx_version" ]; then
        oldest="$(printf '%s\n1.25.1\n' "$nginx_version" | sort -V | head -n1)"
        if [ "$oldest" = "$nginx_version" ] && [ "$nginx_version" != "1.25.1" ]; then
            listen_https="listen 443 ssl http2;
    listen [::]:443 ssl http2;"
            detail "nginx $nginx_version predates 'http2 on;', using the listen parameter"
        fi
    fi
fi

render() {
cat <<EOF
# nginx site configuration for the MyAppStore repository.
# Generated by appstore-nginx; regenerate after changing $CONFIG_FILE.
#
# This file must be included from inside nginx's http { } block, which is where
# both Debian's sites-enabled and RHEL's conf.d are included from. The map below
# is only valid in that context.

# Access keys, rewritten by 'appstore-key sync'.
include $APPSTORE_NGINX_KEYS_FILE;

server {
    listen 80;
    listen [::]:80;
    server_name $server_name;

    # The client speaks HTTPS only. This block exists so that a plain-HTTP
    # request gets a redirect rather than a dead connection, and so that ACME
    # renewals keep working.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://\$host\$request_uri;
    }
}

server {
    $listen_https
    server_name $server_name;

    ssl_certificate     $cert_dir/fullchain.pem;
    ssl_certificate_key $cert_dir/privkey.pem;

    # The client's ModernTLSSocketFactory offers TLS 1.2 and 1.3 only.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:AppStoreTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root $APPSTORE_WWW;
    autoindex off;
    server_tokens off;
    client_max_body_size 1k;

    # Phase 1 access control. \$appstore_access_ok comes from the included map.
    # A server-level 'if' that only returns is the documented-safe use.
    if (\$appstore_access_ok = 0) {
        return 401;
    }

    # The signed repository index. Small, refetched often, and revalidated with
    # ETag / If-None-Match, so it is compressed but never cached downstream.
    location = /$metadata_file {
        limit_except GET HEAD { deny all; }

        default_type application/json;
        gzip on;
        gzip_types application/json;
        gzip_comp_level 6;

        # add_header does not inherit into a location, so every header this
        # response needs has to be repeated here.
        add_header Strict-Transport-Security "max-age=63072000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'none'" always;
        add_header Cache-Control "private, no-cache" always;
    }

    # APKs and v4 signatures. The .gz files are pre-compressed and must be
    # served byte-exact: the client asks for them with Accept-Encoding: identity,
    # resumes with Range requests against the compressed size recorded in the
    # signed metadata, and hashes what it decompresses. Re-encoding here, or
    # letting nginx gzip them, would break resumption.
    location ^~ /packages/ {
        limit_except GET HEAD { deny all; }

        gzip off;
        default_type application/octet-stream;

        add_header Strict-Transport-Security "max-age=63072000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'none'" always;
        # Artifacts at a given versionCode never change.
        add_header Cache-Control "private, max-age=31536000, immutable" always;
    }

    # Nothing else is part of the repository.
    location / {
        return 404;
    }

    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'none'" always;

    access_log /var/log/nginx/appstore.access.log;
    error_log  /var/log/nginx/appstore.error.log;
}
EOF
}

if [ -n "$install_path" ]; then
    staged="$(tmpfile site.conf)"
    render > "$staged"
    mkdir -p "$(dirname "$install_path")"
    install_atomically "$staged" "$install_path"
    info "wrote $install_path"
    detail "enable it, then: nginx -t && systemctl reload nginx"
else
    render
fi
