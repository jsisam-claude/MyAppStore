#!/bin/bash
#
# Print the repo.properties the client is built with.
#
#   appstore-client-config > /path/to/client/repo.properties

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/common.sh
. "$SCRIPT_DIR/lib/common.sh"

usage() {
    cat >&2 <<EOF
usage: appstore-client-config [--key LABEL]

  --key LABEL   use the access key with this label (default: the first one)
EOF
    exit "${1:-1}"
}

want_label=""
while [ $# -gt 0 ]; do
    case "$1" in
        --key) want_label="${2:-}"; shift 2 ;;
        -h|--help) usage 0 ;;
        *) die "unknown argument: $1 (try --help)" ;;
    esac
done

load_config
[ -f "$PUBLIC_KEY_FILE" ] || die "public key not found at $PUBLIC_KEY_FILE. Run appstore-init."

access_key=""
if [ "$APPSTORE_ACCESS_KEY_REQUIRED" = 1 ] && [ -f "$ACCESS_KEYS_FILE" ]; then
    while IFS=$'\t' read -r key label _ || [ -n "$key" ]; do
        case "$key" in ''|'#'*) continue ;; esac
        if [ -z "$want_label" ] || [ "$label" = "$want_label" ]; then
            access_key="$key"
            break
        fi
    done < "$ACCESS_KEYS_FILE"
    if [ -n "$want_label" ] && [ -z "$access_key" ]; then
        die "no access key labelled '$want_label'"
    fi
    [ -n "$access_key" ] || warn "the access gate is required but no key is configured"
fi

cat <<EOF
# Generated by appstore-client-config on $(date -u +%Y-%m-%dT%H:%M:%SZ).
# Contains a shared access key: do not commit this file.
REPO_BASE_URL=$APPSTORE_BASE_URL
REPO_PUBLIC_KEY=$(cat "$PUBLIC_KEY_FILE")
REPO_KEY_VERSION=$APPSTORE_KEY_VERSION
REPO_ACCESS_KEY_HEADER=$APPSTORE_AUTH_HEADER
REPO_ACCESS_KEY=$access_key
EOF
